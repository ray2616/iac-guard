variable "region" {
  type    = string
  default = "ap-south-1"
}
variable "instance_type" {
  type    = string
  default = "t3.medium"
}
variable "credits_verified" {
  type        = bool
  default     = false
  description = "Set true only after checking the actual account plan, service eligibility, credit balance and regional estimate. This is not a spending cap."
}
variable "credit_balance_usd" {
  type    = number
  default = 0
}
variable "verified_session_estimate_usd" {
  type    = number
  default = 0
}
variable "credit_expires_at" {
  type    = string
  default = "2000-01-01T00:00:00Z"
  validation {
    condition     = can(formatdate("YYYY", var.credit_expires_at))
    error_message = "Use an RFC3339 expiration timestamp."
  }
}
variable "release_key" {
  type    = string
  default = "releases/iac-guard-v0.1.0.tar.gz"
  validation {
    condition     = can(regex("^releases/[A-Za-z0-9._-]+\\.tar\\.gz$", var.release_key))
    error_message = "Release key must be a simple releases/*.tar.gz path."
  }
}
variable "release_sha256" {
  type        = string
  description = "SHA256 of the release archive generated by scripts/package_release.py."
  validation {
    condition     = can(regex("^[a-f0-9]{64}$", var.release_sha256))
    error_message = "Provide the actual 64-character lowercase release SHA256."
  }
}
variable "allow_artifact_deletion" {
  type        = bool
  default     = false
  description = "Explicit destructive teardown option: allow removal of all source snapshots and artifact versions."
}
